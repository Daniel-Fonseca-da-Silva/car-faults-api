# Copy to .env and fill in your values.
# Never commit .env.

# App
NODE_ENV=
PORT=
CORS_ORIGINS=

# PostgreSQL (Nest / TypeORM)
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# PostgreSQL (docker-compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_USER_CACHE_TTL_MS=
REDIS_LOOKUP_CACHE_TTL_MS=
REDIS_USER_STATS_CACHE_TTL_MS=

# Auth (JWT)
JWT_SECRET=
# Optional — omit to use app default
# JWT_EXPIRES_IN=

# Auth (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# AI sidecar (car-faults-ai-api)
# AI_PROVIDER: stub | http
AI_PROVIDER=
AI_API_URL=
AI_TRANSLATE_URL=
AI_API_KEY=

# Throttling
THROTTLE_TTL_MS=
THROTTLE_LIMIT=
THROTTLE_AUTH_TTL_MS=
THROTTLE_AUTH_LIMIT=

# Health
HEALTH_MEMORY_HEAP_LIMIT_BYTES=
