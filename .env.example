# Copy to .env and fill in your values.
# Never commit .env.

# App
NODE_ENV=
PORT=
CORS_ORIGINS=

# PostgreSQL (Nest / TypeORM)
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# PostgreSQL (docker-compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_USER_CACHE_TTL_MS=
REDIS_LOOKUP_CACHE_TTL_MS=
REDIS_USER_STATS_CACHE_TTL_MS=

# Auth (JWT)
JWT_SECRET=
# Optional — omit to use app default
# JWT_EXPIRES_IN=

# Auth (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Client must send ?state=<locale> (e.g. pt-PT) to GET /v1/auth/google;
# it is echoed back on the callback to build the web app redirect URL.

# Web app (OAuth callback redirect target, no trailing slash)
WEB_APP_URL=

# Auth cookie (access_token, set on the Google OAuth callback)
# COOKIE_SAME_SITE: lax | strict | none — use "none" if web and API are cross-site in prod
COOKIE_SAME_SITE=
# COOKIE_SECURE: false locally; true in prod (required when COOKIE_SAME_SITE=none)
COOKIE_SECURE=

# AI sidecar (car-faults-ai-api)
# AI_PROVIDER: stub | http
AI_PROVIDER=
AI_API_URL=
AI_TRANSLATE_URL=
AI_API_KEY=

# Throttling
THROTTLE_TTL_MS=
THROTTLE_LIMIT=
THROTTLE_AUTH_TTL_MS=
THROTTLE_AUTH_LIMIT=
THROTTLE_LOOKUPS_TTL_MS=
THROTTLE_LOOKUPS_LIMIT=

# Cloudflare Turnstile (siteverify, checked only on the AI-generation path)
TURNSTILE_SECRET_KEY=
# TURNSTILE_ENABLED: false to bypass verification (local/test only); omit or true otherwise
TURNSTILE_ENABLED=

# Cloudflare R2 (comment image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL comment image URLs are built from (custom/CDN domain or *.r2.dev), no trailing slash
R2_PUBLIC_BASE_URL=

# Health
HEALTH_MEMORY_HEAP_LIMIT_BYTES=
