# Copy to .env and fill in your values.
# Never commit .env.

# App
NODE_ENV=
PORT=
CORS_ORIGINS=
# Optional - number of reverse proxies in front of the API (default 1, Railway edge).
# Used to resolve the real client IP for throttling and Turnstile. Use 0 locally
# without a proxy; add 1 for each extra layer (e.g. Cloudflare proxy in front of Railway).
# TRUST_PROXY_HOPS=

# PostgreSQL (Nest / TypeORM)
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# PostgreSQL (docker-compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Redis
REDIS_HOST=
REDIS_PORT=
# Optional - required when Redis enforces AUTH (e.g. Railway)
# REDIS_USER=
# REDIS_PASSWORD=
REDIS_USER_CACHE_TTL_MS=
REDIS_LOOKUP_CACHE_TTL_MS=
REDIS_USER_STATS_CACHE_TTL_MS=
REDIS_PLATFORM_CACHE_TTL_MS=

# Auth (JWT)
# At least 32 characters; the API refuses to boot otherwise
JWT_SECRET=
# Optional - omit to use app default
# JWT_EXPIRES_IN=

# Auth (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Client must send ?state=<locale> (e.g. pt-PT) to GET /v1/auth/google;
# it is echoed back on the callback to build the web app redirect URL.
# Android OAuth client ID (Google Cloud Console) - accepted as an extra audience
# when verifying idTokens sent by the Android app to POST /v1/auth/google/mobile.
GOOGLE_ANDROID_CLIENT_ID=

# Web app (OAuth callback redirect target, no trailing slash)
WEB_APP_URL=

# Auth cookie (access_token, set on the Google OAuth callback)
# COOKIE_SAME_SITE: lax | strict | none - use "none" if web and API are cross-site in prod
COOKIE_SAME_SITE=
# COOKIE_SECURE: defaults to true; set false only for local HTTP dev.
# "false" is rejected at boot in production and when COOKIE_SAME_SITE=none
COOKIE_SECURE=

# AI sidecar (car-faults-ai-api)
# AI_PROVIDER: stub | http - in production (NODE_ENV=production) this MUST be "http",
# the API refuses to boot with the stub provider outside of local/test environments
# When the API runs in Docker, use host.docker.internal (not localhost) so the
# container can reach the AI published on the host. Requires extra_hosts in
# docker-compose.yml: host.docker.internal:host-gateway
AI_PROVIDER=
AI_API_URL=
AI_TRANSLATE_URL=
AI_API_KEY=

# Throttling (all required, positive integers - validated at boot)
THROTTLE_TTL_MS=
THROTTLE_LIMIT=
THROTTLE_AUTH_TTL_MS=
THROTTLE_AUTH_LIMIT=
THROTTLE_LOOKUPS_TTL_MS=
THROTTLE_LOOKUPS_LIMIT=
# Dedicated limit for mobile AI invocations (X-Client: mobile), which skip Turnstile.
# Counted only when AI actually runs (not on cache/DB hits), keyed by client IP.
THROTTLE_AI_MOBILE_TTL_MS=
THROTTLE_AI_MOBILE_LIMIT=

# Cloudflare Turnstile (siteverify, checked only on the AI-generation path)
TURNSTILE_SECRET_KEY=
# TURNSTILE_ENABLED: false to bypass verification (local/test only); omit or true otherwise.
# The API refuses to boot with TURNSTILE_ENABLED=false when NODE_ENV=production
TURNSTILE_ENABLED=

# Cloudflare R2 (comment image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL comment image URLs are built from (custom/CDN domain or *.r2.dev), no trailing slash
R2_PUBLIC_BASE_URL=

# Health
HEALTH_MEMORY_HEAP_LIMIT_BYTES=
